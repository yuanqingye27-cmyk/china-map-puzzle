.DS_Store
*.zip
docs/*.jpg
node_modules/

# 天地图开发者 Key（本地私密配置，绝不入库）
tools/tianditu.config.json

# 抓取缓存与中间产物（不入库：缓存是本地加速，out/ 是可重建的素材）
.cache/
out/

# 部署产物：由根目录的源文件复制而来，可随时重建，不入库
# （重建方式见 docs/部署到Cloudflare.md）
deploy/
deploy-sichuan/
# deploy-pack.js 生成的按范围裁剪的部署包，也是可丢弃产物
deploy-*/
# ⚠ 反向例外：deploy-templates/ 是**源文件**（Cloudflare 的 _headers/_redirects 模板），
# 必须入库。上面那条 `deploy-*/` 会连它一起匹配掉，所以这里要显式取消。
!deploy-templates/

# 临时下载的二进制（例如隧道工具），不入库
tools/bin/

# Wrangler（Cloudflare CLI）的本地缓存 —— 里面会记账号 id 与邮箱，
# 属于"本机状态"，绝不该入库。它是我自己跑部署命令时生成的，
# 而且当时没被忽略，所以曾经进过一次提交（d833a35）。
# 还没有 push 到远程，所以在首次上传前移除就是干净的。
.wrangler/
